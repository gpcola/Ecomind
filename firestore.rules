rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Visitors collection: users can read/write their own memory
    // Since we don't have mandatory auth in the prompt, but it's good practice.
    // For this app, we'll use a client-side visitor ID.
    // In a real production app, we'd use request.auth.uid.
    // To satisfy security rules, we'll allow based on visitorId if the app sends it.
    match /visitors/{visitorId} {
      allow get, create, update: if true; // In a demo, we allow access to the specific document ID
      allow list: if false;
    }

    match /logs/{logId} {
      allow create: if true;
      allow read, update, delete: if false;
    }
  }
}
